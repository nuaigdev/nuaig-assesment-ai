# Copy to .env.local and fill in. Validated at build and boot by src/lib/env/schema.ts —
# a missing required key fails the build. Keys marked "from Phase N" are optional until then.

# App — the canonical origin. Microsoft redirects to ${NEXT_PUBLIC_APP_URL}/auth/callback,
# which must be registered as a Web redirect URI in the Azure app registration.
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=                   # 32+ random chars: openssl rand -base64 48
AGENT_WORKER_SECRET=              # shared with the agent worker; 32+ random chars (same value in worker/.env)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only, never bundled
# Private ES256 JWK, one line of JSON in single quotes, from
# `npx supabase gen signing-key --algorithm ES256`. `pnpm db:setup` imports it into the project.
SUPABASE_JWT_SIGNING_KEY=

# db:* scripts only (Supabase Management API) — not read by the app, not needed on Vercel
SUPABASE_PROJECT_REF=             # the <ref> in https://<ref>.supabase.co
SUPABASE_ACCESS_TOKEN=            # personal access token (sbp_...); rotate after development

# Microsoft Entra ID — single-tenant app registration, used only for name + email
AZURE_TENANT_ID=                  # directory (tenant) ID GUID
AZURE_CLIENT_ID=                  # application (client) ID
AZURE_CLIENT_SECRET=              # client secret value

# LiveKit Cloud (project → Settings → Keys). Server only; browsers get short-lived tokens.
LIVEKIT_URL=                      # wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ElevenLabs keys belong to the agent worker: see worker/.env.example.

# Anthropic — from Phase 4
ANTHROPIC_API_KEY=

# Behaviour defaults
INTERVIEW_TIME_CAP_MINUTES=45
INTERVIEW_INACTIVITY_SECONDS=90
INVITATION_EXPIRY_DAYS=7
