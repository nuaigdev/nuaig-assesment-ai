# Agent worker configuration. Copy to worker/.env for local runs; set the same on the host.

# LiveKit Cloud (same project as the app)
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_SPEECH_ENGINE_ID=      # seng_… printed by `npm run setup:engine`
ELEVENLABS_VOICE_ID=              # optional; DECISION NEEDED (spec §18.7) — omit for the default voice

# The Next.js app and its shared secret
APP_URL=https://nuaig-assesment-ai.vercel.app
AGENT_WORKER_SECRET=              # same value as the app's AGENT_WORKER_SECRET

# Where ElevenLabs reaches this worker's brain (used by setup:engine only)
BRAIN_PUBLIC_URL=wss://<worker-host>/brain

# Ports: PORT is public (brain + /healthz); HEALTH_PORT is LiveKit's internal health server.
# Render sets PORT itself — don't override it there.
PORT=8080
HEALTH_PORT=8081

# Pre-started job processes (~100 MB each). 0 on small instances such as Render free (512 MB).
NUM_IDLE_PROCESSES=1
